#include <dt-bindings/zmk/input_transform.h>

&trackball_peripheral {
    cpi = <700>;  // 스크롤 속도 (기존 1000 → 700, 30% 감속)
    x-invert;
	/delete-property/ y-invert;
};

/ {
    input_processors {
        zip_scroll_x_scaler: zip_scroll_x_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;
            track-remainders;
        };
    };
};

&trackball_peripheral_split {
	input-processors
		= <
		&zip_xy_to_scroll_mapper
		&zip_scroll_scaler 1 2
		&zip_scroll_x_scaler 0 1 //가로 스크롤 제한
		&zip_ble_report_rate_limit
	>;
};
