&trackball_central {
    cpi = <1000>;
};

// 우측 트랙볼 = 커서 이동 (움직이면 왼쪽 엄지에 클릭 활성화)
// 좌측 트랙볼 = 스크롤 (움직이면 오른쪽 엄지에 클릭 활성화)
//오토마우스 레이어 자동 이탈 설정 (양쪽 트랙볼 공용)
&zip_temp_layer {
    excluded-positions = < //아래는 오토마우스 레이어 중에도 눌러도 되는 키
		10 // GUI (hold)
		11 // ALT (hold)
		12 // CTRL (hold)
		13 // SHIFT (hold)
		21 // RALT
		30 // MCLK (left thumb)
		31 // LCLK (left thumb)
		32 // RCLK (left thumb)
		33 // RCLK (right thumb)
		34 // LCLK (right thumb)
		35 // MCLK (right thumb)
    >;
	require-prior-idle-ms = <300>; //레이어 전환 오작동 방지
};

// 우측(central) 트랙볼: 로컬 센서 이벤트 → Mouse 레이어 자동 활성화
&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;
    input-processors = <
		&zip_ble_report_rate_limit
		&zip_temp_layer 2 9000 //트랙볼 움직이면 Mouse 레이어(2) 자동 활성화, 9초간 유지
	>;
};

// 좌측(peripheral) 트랙볼: split 링크로 전달받은 스크롤 이벤트 → 같은 Mouse 레이어 자동 활성화
&trackball_peripheral_listener {
    status = "okay";
    input-processors = <
		&zip_ble_report_rate_limit
		&zip_temp_layer 2 9000 //좌측 트랙볼(스크롤) 움직여도 동일하게 Mouse 레이어 자동 활성화
	>;
};
