#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    flavor = "balanced";
};

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hm: my_homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "MY_HOMEROW_MOD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            flavor = "tap-preferred";
        };

        RCLK_to_M: RCLK_to_M {
            compatible = "zmk,behavior-tap-dance";
            label = "RCLK_TO_M";
            #binding-cells = <0>;
            bindings = <&mkp RCLK>, <&kp M>;

            tapping-term-ms = <250>;
        };

        hml: hmlayer {
            compatible = "zmk,behavior-hold-tap";
            label = "Home_ROW_Layer";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <130>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc_del {
            bindings = <&hm DEL ESC>;
            key-positions = <0 1>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <20 21>;
        };

        lang {
            bindings = <&hm LG(SPACE) LANGUAGE_1>;
            key-positions = <10 12>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <9 8>;
        };

        minus_equal {
            bindings = <&hm EQUAL MINUS>;
            key-positions = <18 19>;
        };

        slash_quet {
            bindings = <&kp SLASH>;
            key-positions = <29 28>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <29 19>;
        };

        win {
            bindings = <&kp LEFT_WIN>;
            key-positions = <21 22>;
        };

        bt_layer {
            bindings = <&mo 5>;
            key-positions = <4 24>;
        };

        prev_click {
            bindings = <&mkp MB4>;
            key-positions = <15 26>;
        };

        lclk_left {
            bindings = <&mkp LCLK>;
            key-positions = <12 11>;
        };

        mclk_left {
            bindings = <&mkp MCLK>;
            key-positions = <14 15>;
        };

        rclk_left {
            bindings = <&mkp RCLK>;
            key-positions = <13 12>;
        };

        ctrl+shift+num+ {
            bindings = <&kp LC(LS(KP_PLUS))>;
            key-positions = <25 29>;
        };

        prev_left {
            bindings = <&mkp MB4>;
            key-positions = <13 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&hm KP_NUMBER_1 Q  &kp W        &hm KP_NUMBER_3 E  &kp R         &hm PSCRN T     &kp Y         &hm KP_NUMBER_7 U  &kp I      &kp O    &hm KP_NUMBER_0 P
&kp A              &kp S        &kp D              &hml 3 F      &hml 4 G        &kp H         &kp J              &kp K      &kp L    &hm SEMICOLON SQT
&hm LC(Z) Z        &hm LC(X) X  &hm LC(C) C        &hm LC(V) V   &kp B           &hml 3 N      &kp M              &kp COMMA  &kp DOT  &kp ENTER
                                &kp LCTRL          &kp LEFT_ALT  &kp LEFT_SHIFT  &hm END HOME  &mo 1              &kp SPACE
            >;
        };

        Num_layer {
            display-name = "Num";
            bindings = <
&trans     &kp N7        &kp N8  &kp N9  &trans       &kp F11  &kp F12  &trans  &trans  &bootloader
&kp MINUS  &kp N4        &kp N5  &kp N6  &trans       &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&kp N0     &kp NUMBER_1  &kp N2  &kp N3  &bootloader  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
                         &trans  &trans  &trans       &trans   &trans   &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans     &trans      &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans      &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &RCLK_to_M  &trans  &trans  &trans
                &trans  &trans  &trans  &trans     &trans      &trans
            >;
        };

        Scroll_Layrer {
            bindings = <
&trans    &kp UP    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
                    &trans     &trans  &trans  &trans  &trans  &trans
            >;
        };

        Snipe_Layer {
            bindings = <
&trans    &kp UP    &trans     &trans  &trans  &trans    &trans    &trans     &trans  &trans
&kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans    &kp UP    &trans     &trans  &trans
&trans    &trans    &trans     &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
                    &trans     &trans  &trans  &trans    &trans    &trans
            >;

            label = "Snipe";
        };

        BT_Layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                            &trans        &trans  &trans  &trans  &trans  &trans
            >;

            label = "BT";
        };
    };
};
