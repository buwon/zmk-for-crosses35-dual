&trackball_central {
    cpi = <1000>;  // 커서 이동 속도 (700에서 저속 이동 시 커서가 잘 안 움직여 1000으로 복원)
};

// 우측 트랙볼 = 커서 이동
// 좌측 트랙볼 = 스크롤
// 마우스 레이어는 엄지로 U_MOUSE를 홀드해 수동으로만 전환한다 (자동 전환 없음).
&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;
    input-processors = <&zip_ble_report_rate_limit>;
};

&trackball_peripheral_listener {
    status = "okay";
    input-processors = <&zip_ble_report_rate_limit>;
};
